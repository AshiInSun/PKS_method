from pathlib import Path
import os

configfile: "config.yaml"

OUT_DIR = config["out_dir"]
RESULTS_DIR = config["results_dir"]

# ------------------------------------------------
# Discover graphs + generators automatically
# ------------------------------------------------

targets = []

for cluster_dir in sorted(Path(OUT_DIR).glob("*_cluster")):
    if not cluster_dir.is_dir():
        continue

    for graph_dir in sorted(cluster_dir.glob("out_*")):
        if not graph_dir.is_dir():
            continue

        gmls = list(graph_dir.glob("*.gml"))
        if len(gmls) == 0:
            continue

        original_graph = gmls[0]
        graph_name = original_graph.stem
        cluster_name = cluster_dir.name

        gen_dirs = sorted([
            d for d in graph_dir.iterdir()
            if d.is_dir() and d.name.startswith("gen")
        ])

        for gen_dir in gen_dirs:
            model = gen_dir.name

            targets.append(
                f"{RESULTS_DIR}/{cluster_name}/{graph_name}/{model}/analysis_done.txt"
            )

# ------------------------------------------------
# Rule all
# ------------------------------------------------

rule all:
    input:
        targets


# ------------------------------------------------
# Graphlet counting
# ------------------------------------------------

rule graphlet_count:
    input:
        graph=f"{OUT_DIR}/{{cluster}}/out_{{graph}}/{{graph}}.gml",
        generated=f"{OUT_DIR}/{{cluster}}/out_{{graph}}/{{model}}"
    output:
        f"{RESULTS_DIR}/{{cluster}}/{{graph}}/{{model}}/graphlet_counts.json"
    shell:
        """
        python graphlet_analysis.py \
            {input.generated} \
            {input.graph} \
            {output}
        """


# ------------------------------------------------
# Translation induced -> brut
# ------------------------------------------------

rule translate_counts:
    input:
        json=f"{RESULTS_DIR}/{{cluster}}/{{graph}}/{{model}}/graphlet_counts.json"
    output:
        f"{RESULTS_DIR}/{{cluster}}/{{graph}}/{{model}}/graphlet_counts_brut.json"
    shell:
        """
        python translation_g5_inducedtobrut.py {input.json} {output}
        """


# ------------------------------------------------
# Figures / analysis
# ------------------------------------------------

rule build_analysis:
    input:
        induced=f"{RESULTS_DIR}/{{cluster}}/{{graph}}/{{model}}/graphlet_counts.json",
        brut=f"{RESULTS_DIR}/{{cluster}}/{{graph}}/{{model}}/graphlet_counts_brut.json"
    output:
        done=f"{RESULTS_DIR}/{{cluster}}/{{graph}}/{{model}}/analysis_done.txt"
    shell:
        """
        python build_analysis.py {input.induced} {input.brut}
        touch {output.done}
        """