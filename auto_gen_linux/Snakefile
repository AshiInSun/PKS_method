import os
import glob

# Detect all graphs in out/*_cluster/out_*/
GRAPH_PATHS = glob.glob("out/*_cluster/out_*")
GRAPH_ENTRIES = [
    (os.path.basename(os.path.dirname(p)), os.path.basename(p))
    for p in GRAPH_PATHS
    if os.path.isdir(p)
]
# Example: [("bowtie_cluster", "out_12434578798"), ...]

# ------------------------------------------------------------
# ONLY FTR1 IS ACTIVE
# ------------------------------------------------------------

def all_targets(wildcards):
    targets = []
    for cluster, out_dir in GRAPH_ENTRIES:
        targets.append(f"out/{cluster}/{out_dir}/gen_ftr1/done.txt")
    return targets


rule all:
    input:
        all_targets


# ------------------------------------------------------------
# ACTIVE RULE: FTR1
# ------------------------------------------------------------

rule generate_ftr1:
    input:
        gml="out/{cluster}/{out_dir}/{out_dir}.gml"
    wildcard_constraints:
        cluster="[^/]+_cluster",
        out_dir="out_[^/]+"
    output:
        done="out/{cluster}/{out_dir}/gen_ftr1/done.txt"
    log:
        "out/{cluster}/{out_dir}/gen_ftr1/run.log"
    shell:
        """
        timeout 3600 python -m kedgeswap.main -f {input.gml} \
        -o out/{wildcards.cluster}/{wildcards.out_dir}/gen_ftr1/g \
        -gml -v -a -g 3 --output_number 50 -ftr 1 -acfs \
        2>&1 | tee {log} && \
        echo done > {output.done}
        """


# ------------------------------------------------------------
# INACTIVE RULE (kept for reference only)
# ------------------------------------------------------------

rule generate_no_constraint:
    message:
        "DISABLED: kept for reference only"
    input:
        gml="out/{cluster}/{out_dir}/{out_dir}.gml"
    wildcard_constraints:
        cluster="[^/]+_cluster",
        out_dir="out_[^/]+"
    output:
        done="out/{cluster}/{out_dir}/gen_no_constraint/done.txt"
    log:
        "out/{cluster}/{out_dir}/gen_no_constraint/run.log"
    shell:
        """
        echo "This rule is disabled" | tee {log}
        echo disabled > {output.done}
        """