import os
import glob

# Detect all graphs in out/*_cluster/out_*/
GRAPH_PATHS = glob.glob("out/*_cluster/out_*")
GRAPH_ENTRIES = [
    (
        os.path.basename(os.path.dirname(p)),  # cluster
        os.path.basename(p),                   # out_ID
        os.path.basename(p).replace("out_", "", 1)  # ID
    )
    for p in GRAPH_PATHS
    if os.path.isdir(p)
]

def all_targets(wildcards):
    return [
        f"out/{cluster}/{out_dir}/gen_ftr1/done.txt"
        for cluster, out_dir, name in GRAPH_ENTRIES
    ]

rule all:
    input: all_targets

rule generate_ftr1:
    input:
        gml="out/{cluster}/{out_dir}/{name}.gml"
    wildcard_constraints:
        cluster="[^/]+_cluster",
        out_dir="out_[^/]+",
        name="[^/]+"
    output:
        done="out/{cluster}/{out_dir}/gen_ftr1/done.txt"
    log:
        "out/{cluster}/{out_dir}/gen_ftr1/run.log"
    shell:
        "timeout 3600 python -m kedgeswap.main -f {input.gml} "
        "-o out/{wildcards.cluster}/{wildcards.out_dir}/gen_ftr1/g "
        "-gml -v -a -g 3 --output_number 50 -ftr 1 2>&1 | tee {log} && "
        "echo done > {output.done}"