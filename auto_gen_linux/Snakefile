import os
import glob

GRAPH_PATHS = glob.glob("out/*_cluster/out_*")
GRAPH_ENTRIES = [
    (os.path.basename(os.path.dirname(p)), os.path.basename(p))
    for p in GRAPH_PATHS
    if os.path.isdir(p)
]


def get_graph_input(cluster, out_dir):
    base = f"out/{cluster}/{out_dir}/{out_dir.replace('out_', '', 1)}"

    for ext, flag in [
        ("gml", "-gml"),
        ("ssv", ""),
        ("edges", ""),
        ("mtx", ""),
    ]:
        path = f"{base}.{ext}"
        if os.path.exists(path):
            return path, flag

    raise FileNotFoundError(f"Aucun graphe trouvé pour {base}")


def all_targets(wildcards):
    targets = []

    for cluster, out_dir in GRAPH_ENTRIES:
        ftr1_done = f"out/{cluster}/{out_dir}/gen_ftr1/done.txt"

        if os.path.exists(ftr1_done):
            targets.extend([
                f"out/{cluster}/{out_dir}/gen_no_constraint/done.txt",
                f"out/{cluster}/{out_dir}/gen_jdm/done.txt",
                f"out/{cluster}/{out_dir}/gen_f3ccr1/done.txt",
            ])
        else:
            targets.append(ftr1_done)

    return targets


rule all:
    input:
        all_targets


rule generate_ftr1:
    input:
        graph=lambda wc: get_graph_input(wc.cluster, wc.out_dir)[0]
    params:
        graph_flag=lambda wc: get_graph_input(wc.cluster, wc.out_dir)[1]
    wildcard_constraints:
        cluster="[^/]+_cluster",
        out_dir="out_[^/]+"
    output:
        done="out/{cluster}/{out_dir}/gen_ftr1/done.txt"
    log:
        "out/{cluster}/{out_dir}/gen_ftr1/run.log"
    shell:
        "timeout 7200 python -u -m kedgeswap.main "
        "-f {input.graph} "
        "{params.graph_flag} "
        "-o out/{wildcards.cluster}/{wildcards.out_dir}/gen_ftr1/g "
        "-v -a -g 3 --output_number 50 -ftr 1 "
        "2>&1 | tee {log} && "
        "echo done > {output.done}"


rule generate_no_constraint:
    input:
        graph=lambda wc: get_graph_input(wc.cluster, wc.out_dir)[0],
        ftr1_done="out/{cluster}/{out_dir}/gen_ftr1/done.txt"
    params:
        graph_flag=lambda wc: get_graph_input(wc.cluster, wc.out_dir)[1]
    wildcard_constraints:
        cluster="[^/]+_cluster",
        out_dir="out_[^/]+"
    output:
        done="out/{cluster}/{out_dir}/gen_no_constraint/done.txt"
    log:
        "out/{cluster}/{out_dir}/gen_no_constraint/run.log"
    shell:
        "timeout 3600 python -u -m kedgeswap.main "
        "-f {input.graph} "
        "{params.graph_flag} "
        "-o out/{wildcards.cluster}/{wildcards.out_dir}/gen_no_constraint/g "
        "-v -a -g 3 --output_number 50 "
        "2>&1 | tee {log} && "
        "echo done > {output.done}"


